# Copy to .streamlit/secrets.toml for local Streamlit runs, or paste the same
# keys into the Streamlit Community Cloud secrets manager for deployment.
# The real secrets.toml is gitignored.

SUPABASE_URL = ""
SUPABASE_KEY = ""
ANTHROPIC_API_KEY = ""
GARMIN_EMAIL = ""
GARMIN_PASSWORD = ""
# Optional but recommended for cloud: a Garmin OAuth token blob minted locally
# with `python -m scripts.garmin_login`. Password login is CAPTCHA-blocked from
# datacenter IPs; a saved token avoids it. Leave blank to use email/password.
GARMIN_TOKENS = ""
# Optional. Seconds to wait between per-day Garmin fetches. 0 is fine for short
# syncs; set ~1-2 for a 365-day backfill to avoid Garmin rate limits.
GARMIN_PACING_SECONDS = "0"
WHOOP_CLIENT_ID = ""
WHOOP_CLIENT_SECRET = ""
WHOOP_REDIRECT_URI = "http://localhost:8501"
# The app password gate was removed; APP_PASSWORD / DISABLE_AUTH are no longer
# read. The app is open to anyone who can reach its URL.
# Optional. Slack/Discord incoming webhook; the daily sync posts here on real
# failures. Leave blank to disable alerts. Add as a GitHub Actions secret too.
ALERT_WEBHOOK_URL = ""
